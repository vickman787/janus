# Base mainnet is the only supported network. Never point these at a testnet.
JANUS_RPC_URL=https://mainnet.base.org
JANUS_CHAIN_ID=8453
JANUS_EXPLORER_URL=https://basescan.org

# Current owner signer (deploys the demo contract and starts transfers).
JANUS_OWNER_KEY=

# Target owner signer (accepts the pending ownership).
JANUS_TARGET_KEY=

# Optional contract address when one is already deployed. Janus writes the
# address it deploys to janus/data/deployed.json automatically.
# JANUS_CONTRACT_ADDRESS=

# Sibyl memory database file.
JANUS_MEMORY_DB=~/.sibyl-memory/janus.db

# Verify onchain runtime bytecode against the committed artifact on every
# read. Disable only for local test EVMs that deploy custom builds.
# JANUS_VERIFY_CODE=1
